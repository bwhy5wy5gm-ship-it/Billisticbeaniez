generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("user")
  isAdmin        Boolean   @default(false)
  accounts       Account[]
  sessions       Session[]
}

model AdminSignupRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SensorData {
  id        String   @id @default(cuid())
  tank      String
  co2       Float
  oxygen    Float
  humidity  Float
  temperature Float
  timestamp DateTime @default(now())
}

model ExperimentLog {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AccessLog {
  id        String   @id @default(cuid())
  page      String
  visitorId String?
  userAgent String?
  timestamp DateTime @default(now())
}

model SiteSettings {
  id             String  @id @default(cuid())
  key            String  @unique
  value          String
  dashboardOn    Boolean @default(true)
  updatesPageOn  Boolean @default(true)
}

model PhotoLog {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        String
  photos      String   @default("[]")
  group       String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String
  photos      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String
  company     String   @default("")
  person      String   @default("")
  photos      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChartData {
  id             String @id @default(cuid())
  label          String
  day            Int
  co2Control     Float  @default(0)
  co2Exp         Float  @default(0)
  o2Control      Float  @default(0)
  o2Exp          Float  @default(0)
  tempControl    Float  @default(0)
  tempExp        Float  @default(0)
  humidityControl Float @default(0)
  humidityExp    Float  @default(0)
}

model TeamHistory {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String
  photos      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
